{
  "name": "datadrip",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "node scripts/init-db.js",
    "db:reset": "node scripts/migrate-db.js reset-db",
    "db:migrate": "node scripts/migrate-db.js",
    "db:list": "node scripts/migrate-db.js list-tables",
    "db:add-table": "node scripts/migrate-db.js add-table",
    "db:reset-tables": "node scripts/migrate-db.js reset-db",
    "db:update-categories": "node scripts/update-product-categories.js",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod": "docker-compose up --build",
    "docker:prod:down": "docker-compose down",
    "jenkins:up": "docker-compose up jenkins -d",
    "jenkins:down": "docker-compose stop jenkins",
    "jenkins:setup": "bash scripts/setup-jenkins.sh",
    "jenkins:setup:complete": "bash scripts/setup-jenkins-complete.sh",
    "jenkins:plugins": "bash scripts/install-jenkins-plugins.sh",
    "jenkins:logs": "docker logs datadrip-jenkins -f",
    "db:seed:roles": "node scripts/seed-roles.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/pg": "^8.10.9",
    "bcryptjs": "^2.4.3",
    "next": "15.5.0",
    "pg": "^8.11.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
