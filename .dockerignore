# Docker build context exclusions
# Keep essential files for Docker build

# Docker files (exclude from build context)
Dockerfile
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# Dependencies (will be installed fresh in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Documentation and config files
README.md
CHANGELOG.md
LICENSE
CONTRIBUTING.md
.git/
.gitignore
.gitattributes

# Linting and formatting configs
.eslintrc*
.prettierrc*
.editorconfig
.stylelintrc*

# Environment files (sensitive data)
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs and caches
.next/
.vercel/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Testing and coverage
coverage/
.nyc_output/
.jest/
test-results/
playwright-report/
test-results.xml
__tests__/
**/*.test.*
**/*.spec.*

