# Database Configuration
# These will be automatically set by Railway when you add a PostgreSQL service
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datadrip
DB_USER=postgres
DB_PASSWORD=your_password_here

# Application Configuration
NODE_ENV=development
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# Railway will automatically provide these environment variables:
# DATABASE_URL - Complete PostgreSQL connection string
# PGHOST - PostgreSQL host
# PGPORT - PostgreSQL port
# PGDATABASE - PostgreSQL database name
# PGUSER - PostgreSQL username
# PGPASSWORD - PostgreSQL password

# OAuth Configuration for Platform Integrations
# TikTok Shop OAuth
TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Shopee OAuth
SHOPEE_CLIENT_ID=your_shopee_partner_id
SHOPEE_CLIENT_SECRET=your_shopee_partner_key

# Lazada OAuth
LAZADA_CLIENT_ID=your_lazada_client_id
LAZADA_CLIENT_SECRET=your_lazada_client_secret

# Application URL (for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

